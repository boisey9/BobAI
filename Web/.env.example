# Public Bob Core base URL. The bearer token remains server-side.
BOB_CORE_BASE_URL=https://bob-core.vercel.app

# Existing Bob Core credential. Never prefix with NEXT_PUBLIC_.
BOB_CORE_DEVICE_TOKEN=replace-with-the-existing-bob-core-device-token

# Owner-only Control Center authentication.
BOB_CONTROL_CENTER_OWNER_PASSWORD=replace-with-a-long-unique-password
BOB_CONTROL_CENTER_SESSION_SECRET=replace-with-at-least-32-random-characters

# First project selected in the dashboard.
BOB_CONTROL_CENTER_DEFAULT_PROJECT=bobai
