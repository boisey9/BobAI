# Public Bob Core base URL. The bearer token remains server-side.
BOB_CORE_BASE_URL=https://bob-core.vercel.app

# Existing Bob Core credential. Never prefix with NEXT_PUBLIC_.
BOB_CORE_DEVICE_TOKEN=replace-with-the-existing-bob-core-device-token

# Optional server-only access to a protected Core preview. Used only on Vercel previews.
BOB_CORE_PREVIEW_BYPASS_SECRET=

# Owner-only Control Center authentication.
BOB_CONTROL_CENTER_OWNER_PASSWORD=replace-with-a-long-unique-password
BOB_CONTROL_CENTER_SESSION_SECRET=replace-with-at-least-32-random-characters

# First project selected in the dashboard.
BOB_CONTROL_CENTER_DEFAULT_PROJECT=bobai

# Enable only after the reviewed auth migration and offline bootstrap have passed.
# The owner email is a server-only deployment value; public registration is closed.
BOB_AUTH_ENABLED=false
BOB_AUTH_BASE_URL=https://your-bob-web-domain.example
BOB_AUTH_OWNER_EMAIL=owner@example.com
BOB_AUTH_SECRET=replace-with-a-separate-random-secret-of-at-least-32-characters
BOB_AUTH_DATABASE_URL=postgresql://replace-through-your-secret-manager
# Temporarily enabled for setup/recovery, then disabled after passkey acceptance.
BOB_AUTH_PASSWORD_LOGIN_ENABLED=false
