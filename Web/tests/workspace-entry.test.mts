import {test} from 'node:test';import assert from 'node:assert/strict';import {safeWorkspaceDestination,workspaceLoginDestination,workspaceEntryEnabled} from '../lib/workflow-entry.ts';import {packetNextStep,packetStateLabel} from '../lib/workspace-journey.ts';
test('scoped destinations never redirect externally or assert identity',()=>{assert.equal(safeWorkspaceDestination('/work?project=sample&packet=p1&operation=op-1'),'/work?project=sample&packet=p1&operation=op-1');for(const v of ['https://foreign.invalid/work','//foreign.invalid/work','/work/../account','/work#x','/work?project=x&project=y','/work?actor=owner','/work?project=%0Aevil','/work?packet=%2Fprivate','/work?returnTo=https://evil','/work\\evil',' /work',null])assert.equal(safeWorkspaceDestination(v),null);assert.equal(workspaceLoginDestination('/work?project=sample'),'/login?returnTo=%2Fwork%3Fproject%3Dsample');});
test('entry defaults off and hosted stays off',()=>{const saved=[process.env.BOB_GOVERNED_WORKFLOW_ENABLED,process.env.VERCEL];try{delete process.env.VERCEL;delete process.env.BOB_GOVERNED_WORKFLOW_ENABLED;assert.equal(workspaceEntryEnabled(),false);process.env.BOB_GOVERNED_WORKFLOW_ENABLED='true';assert.equal(workspaceEntryEnabled(),true);process.env.VERCEL='1';assert.equal(workspaceEntryEnabled(),false);}finally{for(const [i,k] of ['BOB_GOVERNED_WORKFLOW_ENABLED','VERCEL'].entries()){if(saved[i]===undefined)delete process.env[k];else process.env[k]=saved[i];}}});
const packet:any={id:'p',title:'Work',specification:'Criteria',specificationDigest:'s',state:'draft',version:1,acceptanceCurrent:false,candidateId:null,candidateDigest:null};const workspace:any={paused:false,policyConfigured:true,records:[{packetId:'p',kind:'specification',content:{digest:'s'}}],packetEvidence:[]};
test('next action distinguishes specification and producer requirements',()=>{assert.equal(packetNextStep(workspace,{...packet,specification:''}).action,'edit');assert.equal(packetNextStep({...workspace,records:[]},packet).action,'specification');assert.equal(packetNextStep(workspace,packet).title,'Awaiting implementation and evidence');assert.equal(packetNextStep({...workspace,policyConfigured:false},packet).title,'Verification policy is not accepted');});
test('missing/expired/unverified/wrong-candidate evidence cannot guide approval',()=>{for(const status of ['missing','expired','verification_pending','failed']){const p={...packet,candidateId:'c',candidateDigest:'d'},data={...workspace,packetEvidence:[{packetId:'p',candidateDigest:'d',bindingCurrent:true,candidatePresent:true,evidenceComplete:false,checks:[{id:'check',status}]}]};assert.equal(packetNextStep(data,p).action,'evidence');}assert.equal(packetNextStep({...workspace,packetEvidence:[{packetId:'p',candidateDigest:'other',bindingCurrent:true,candidatePresent:true,evidenceComplete:true}]},{...packet,candidateId:'c',candidateDigest:'d'}).action,'evidence');});
test('current verification guides ready/review/history without release authority',()=>{const p={...packet,candidateId:'c',candidateDigest:'d'},data={...workspace,packetEvidence:[{packetId:'p',candidateDigest:'d',bindingCurrent:true,candidatePresent:true,evidenceComplete:true}]};assert.equal(packetNextStep(data,p).action,'ready');assert.equal(packetNextStep(data,{...p,state:'ready'}).action,'review');assert.equal(packetNextStep(data,{...p,state:'reviewed',acceptanceCurrent:true}).action,'history');assert.equal(packetNextStep(data,{...p,state:'reviewed'}).title,'Renew this review');assert.equal(packetStateLabel({...p,state:'reviewed'}),'Review needs renewal');assert.equal(packetNextStep({...data,paused:true},p).title,'Work is paused');});
