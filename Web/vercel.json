{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "codex/daily-continuity": false,
      "codex/recovery-access": false,
      "codex/recovery-operations": false,
      "codex/database-error-safety": false
    }
  },
  "framework": "nextjs",
  "installCommand": "npm ci --no-audit --no-fund",
  "buildCommand": "npm run build"
}
