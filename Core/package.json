{
  "name": "@bobai/core",
  "version": "0.2.0",
  "private": true,
  "description": "Secure backend for BobAI conversations, memory, shared context, and tools.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:import:bobai": "node scripts/import-bob-bundle.mjs --file imports/bobai-bootstrap-v1.json --dry-run",
    "check:import:rfq": "node scripts/import-bob-bundle.mjs --file imports/rfq-bootstrap-v1.json --dry-run",
    "check:import:fomoflow": "node scripts/import-bob-bundle.mjs --file imports/fomoflow-bootstrap-v1.json --dry-run",
    "check:import": "npm run check:import:bobai && npm run check:import:rfq && npm run check:import:fomoflow",
    "check": "npm run typecheck && npm test && npm run check:import",
    "import:bootstrap": "node scripts/import-bob-bundle.mjs",
    "generate:token": "node scripts/generate-device-token.mjs",
    "generate:interface-token": "node scripts/generate-interface-token.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
    "@hono/node-server": "2.0.12",
    "@modelcontextprotocol/server": "2.0.0",
    "@neondatabase/serverless": "1.1.0",
    "hono": "4.12.23",
    "openai": "7.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "tsx": "4.23.1",
    "typescript": "5.8.3",
    "vitest": "4.1.10"
  }
}
