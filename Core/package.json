{
  "name": "@bobai/core",
  "version": "0.1.0",
  "private": true,
  "description": "Secure backend for BobAI conversations, memory, and tools.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test",
    "generate:token": "node scripts/generate-device-token.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.0.12",
    "@neondatabase/serverless": "1.1.0",
    "hono": "4.12.23",
    "openai": "7.3.0",
    "zod": "4.0.9"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "tsx": "4.23.1",
    "typescript": "5.8.3",
    "vitest": "4.1.10"
  }
}
