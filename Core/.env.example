# Never commit the real values from your local .env file.

# Recommended no-cost Bob Core provider.
AI_PROVIDER=zai
ZAI_API_KEY=
ZAI_MODEL=glm-4.7-flash
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# Optional generic overrides supported for either provider.
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=

# Optional OpenAI fallback. Set AI_PROVIDER=openai to use it.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini

# Memory v0.1. Use the private Neon connection string only on Bob Core.
DATABASE_URL=
BOB_CORE_OWNER_ID=rick
BOB_CORE_MEMORY_ENABLED=true
BOB_CORE_MEMORY_RETRIEVAL_LIMIT=6

# Shared Context v0.2. Keep false until migration 002 is applied and the
# initial project records are registered in the private BobAI database.
BOB_CORE_SHARED_CONTEXT_ENABLED=false

BOB_CORE_DEVICE_TOKEN=
BOB_CORE_MAX_OUTPUT_TOKENS=700
PORT=8787
NODE_ENV=development
