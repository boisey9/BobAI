# Never commit the real values from your local .env file.

# Recommended no-cost Bob Core provider.
AI_PROVIDER=zai
ZAI_API_KEY=
ZAI_MODEL=glm-4.7-flash
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# Optional generic overrides supported for either provider.
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=

# Optional OpenAI fallback. Set AI_PROVIDER=openai to use it.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini

BOB_CORE_DEVICE_TOKEN=
BOB_CORE_MAX_OUTPUT_TOKENS=700
PORT=8787
NODE_ENV=development
